@page "/"
@rendermode InteractiveServer

<PageTitle>@Strings.AppTitle</PageTitle>

<MudStack Spacing="4" Class="py-8">
    <MudTextField @bind-Value="_prompt"
                  Placeholder="@Strings.SearchPlaceholder"
                  Variant="Variant.Outlined"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Outlined.Search"
                  Immediate="true"
                  Disabled="_busy || _loadingModel"
                  OnKeyDown="OnKeyDown"
                  FullWidth="true"/>

    @if (_loadingModel)
    {
        <MudStack Spacing="1">
            <MudProgressLinear Value="@_downloadPercent"
                               Color="Color.Primary"
                               Rounded="true"/>
            <MudStack Row="true" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.caption">@_loadingStatus</MudText>
                <MudText Typo="Typo.caption">@_downloadPercent%</MudText>
            </MudStack>
        </MudStack>
    }
    else if (_busy)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary"/>
    }

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }

    @if (_answer is not null)
    {
        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <MudText Typo="Typo.body1" Style="white-space: pre-wrap;">@_answer</MudText>
        </MudPaper>
    }

    @if (_results.Count > 0)
    {
        <MudPaper Class="pa-4" Elevation="0" Outlined="true">
            <MudText Typo="Typo.overline">@_results.Count</MudText>
            <MudStack Spacing="1">
                @foreach (var result in _results)
                {
                    <div>
                        <MudLink Href="@result.Url" Target="_blank" rel="noopener noreferrer" Typo="Typo.body2">@result.Title</MudLink>
                        <MudText Typo="Typo.caption" Class="ml-2">@result.Engine</MudText>
                    </div>
                }
            </MudStack>
        </MudPaper>
    }
</MudStack>
