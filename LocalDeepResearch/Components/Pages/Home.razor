@page "/"
@rendermode InteractiveServer
@using LocalDeepResearch.Research
@using LocalDeepResearch.Search

<PageTitle>@Strings.AppTitle</PageTitle>

<MudStack Spacing="4" Class="py-8">
    <MudTextField @bind-Value="_prompt"
                  Placeholder="@Strings.SearchPlaceholder"
                  Variant="Variant.Outlined"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Outlined.Search"
                  Immediate
                  MaxLength="100"
                  Disabled="_busy || _loadingModel"
                  OnKeyDown="OnKeyDown"
                  FullWidth />

    <MudSlider T="double"
               @bind-Value="_pageThreshold"
               Min="0"
               Max="1"
               Step="0.1"
               ValueLabel
               Disabled="_busy || _loadingModel">@string.Format(Strings.PageThreshold, _pageThreshold)</MudSlider>

    @if (_loadingModel)
    {
        <MudStack Spacing="1">
            <MudProgressLinear Value="@_downloadPercent"
                               Color="Color.Primary"
                               Rounded />
            <MudStack Row Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.caption">@_loadingStatus</MudText>
                <MudText Typo="Typo.caption">@_downloadPercent%</MudText>
            </MudStack>
        </MudStack>
    }
    else if (_busy)
    {
        <MudStack Spacing="1">
            <MudProgressLinear Indeterminate Color="Color.Primary"/>
            @if (_runStatus is not null)
            {
                <MudText Typo="Typo.caption">@_runStatus</MudText>
            }
        </MudStack>
    }

    @if (Chat.IsModelLoaded)
    {
        <MudChip T="string"
                 Size="Size.Small"
                 Variant="Variant.Outlined"
                 Class="align-self-start"
                 Color="@(Chat.IsGpuActive ? Color.Success : Color.Warning)">
            @(Chat.IsGpuActive ? "GPU" : "CPU")
        </MudChip>
    }

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }

    @if (_sections.Count > 0)
    {
        <MudPaper Class="pa-4" Elevation="0" Outlined>
            @if (_plan is not null)
            {
                <MudText Typo="Typo.h5" Class="mb-4">@_plan.Title</MudText>
            }

            @if (_summary is not null)
            {
                <MudText Typo="Typo.h6">@Strings.ExecutiveSummary</MudText>
                <MudText Typo="Typo.body1" Class="mt-2 mb-6" Style="white-space: pre-wrap;">@_summary</MudText>
            }

            @foreach (Section section in _sections)
            {
                <MudText Typo="Typo.h6">@section.Heading</MudText>
                <MudText Typo="Typo.body1" Class="mt-2" Style="white-space: pre-wrap;">@section.Text</MudText>

                <MudExpansionPanels Elevation="0" Outlined Dense Class="mt-2 mb-6">
                    <MudExpansionPanel Text="@Strings.Sources">
                        <MudStack Spacing="1" AlignItems="AlignItems.Start">
                            @foreach (Source source in section.Sources)
                            {
                                <MudLink Href="@source.Url" Target="_blank" rel="noopener noreferrer" Typo="Typo.body2">@Helpers.Truncate(source.Title, MaxSourceLengthChars)</MudLink>
                            }
                        </MudStack>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }

            @if (Chat.Result.HasValue)
            {
                var result = Chat.Result.Value;
                double tokensPerSecond = result.Timings?.CompletionTokensPerSecond ?? 0;
                TimeSpan duration = result.Timings?.CompletionDuration ?? TimeSpan.Zero;

                <MudStack Row Spacing="3" Class="mt-4">
                    <MudText Typo="Typo.caption">@($"{tokensPerSecond:F1} tok/s")</MudText>
                    <MudText Typo="Typo.caption">@string.Format(Strings.TokenCount, result.Usage.CompletionTokens)</MudText>
                    <MudText Typo="Typo.caption">@Helpers.FormatDuration(duration)</MudText>
                </MudStack>
            }
        </MudPaper>
    }

    @if (_results.Count > 0 && _scores.Length == _results.Count)
    {
        <MudPaper Class="pa-4" Elevation="0" Outlined>
            <MudText Typo="Typo.overline">@_keptCount / @_results.Count</MudText>
            <MudStack Spacing="1">
                @for (int i = 0; i < _results.Count; i++)
                {
                    SearchResult result = _results[i];
                    float score = _scores[i];

                    <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                        <MudLink Href="@result.Url" Target="_blank" rel="noopener noreferrer" Typo="Typo.body2">@Helpers.Truncate(result.Title, MaxSourceLengthChars)</MudLink>
                        <MudText Typo="Typo.caption">@result.Engine</MudText>
                        <MudSpacer />
                        <MudText Typo="Typo.caption" Color="@(score >= _pageThreshold ? Color.Success : Color.Error)">@score.ToString("P0")</MudText>
                    </MudStack>
                }
            </MudStack>
        </MudPaper>
    }
</MudStack>
