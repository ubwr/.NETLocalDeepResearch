@page "/"
@using LMSupply.Generator.Gguf
@using LocalDeepResearch.Research
@using LocalDeepResearch.Search

<PageTitle>@Strings.AppTitle</PageTitle>

<MudStack Spacing="4" Class="py-8">
    <MudTextField @bind-Value="_prompt"
                  Placeholder="@Strings.SearchPlaceholder"
                  Variant="Variant.Outlined"
                  Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Outlined.Search"
                  Immediate
                  MaxLength="100"
                  Disabled="_busy || _loadingModel"
                  OnKeyDown="OnKeyDown"
                  FullWidth />

    @if (!_busy && !_loadingModel && Chat.IsModelLoaded && Reranker.IsModelLoaded)
    {
        <MudSelect T="string"
                   Value="@_selectedModel"
                   ValueChanged="SelectModelAsync"
                   Label="@Strings.Model"
                   Variant="Variant.Outlined"
                   Dense>
            @foreach (GgufModelInfo model in Models)
            {
                <MudSelectItem Value="@model.RepoId">@model.DisplayName</MudSelectItem>
            }
            <MudSelectItem Value="@CustomModelOption">@Strings.CustomModel</MudSelectItem>
        </MudSelect>

        @if (_selectedModel == CustomModelOption)
        {
            <MudStack Row AlignItems="AlignItems.Center">
                <MudTextField @bind-Value="_customModelId"
                              Placeholder="@Strings.CustomModelPlaceholder"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
                <MudButton Variant="Variant.Outlined"
                           OnClick="() => SwitchModelAsync(_customModelId)">@Strings.LoadModel</MudButton>
            </MudStack>
        }

        <MudSlider T="double"
                   @bind-Value="_pageThreshold"
                   Min="0"
                   Max="1"
                   Step="0.05"
                   ValueLabel>
            <span class="d-inline-flex align-center gap-1">
                @string.Format(Strings.PageThreshold, _pageThreshold)
                <MudTooltip Text="@Strings.PageThresholdTooltip">
                    <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" Class="d-block" />
                </MudTooltip>
            </span>
        </MudSlider>
        <MudSlider T="double"
                   @bind-Value="_passageThreshold"
                   Min="0"
                   Max="1"
                   Step="0.05"
                   ValueLabel>
            <span class="d-inline-flex align-center gap-1">
                @string.Format(Strings.PassageThreshold, _passageThreshold)
                <MudTooltip Text="@Strings.PassageThresholdTooltip">
                    <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" Class="d-block" />
                </MudTooltip>
            </span>
        </MudSlider>
        <MudSlider T="int"
                   @bind-Value="_minSites"
                   Min="1"
                   Max="5"
                   Step="1"
                   ValueLabel>
            <span class="d-inline-flex align-center gap-1">
                @string.Format(Strings.MinSites, _minSites)
                <MudTooltip Text="@Strings.MinSitesTooltip">
                    <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" Class="d-block" />
                </MudTooltip>
            </span>
        </MudSlider>
        <MudSlider T="int"
                   @bind-Value="_sectionCount"
                   Min="1"
                   Max="6"
                   Step="1"
                   ValueLabel>
            <span class="d-inline-flex align-center gap-1">
                @string.Format(Strings.AdditionalSections, _sectionCount)
                <MudTooltip Text="@Strings.AdditionalSectionsTooltip">
                    <MudIcon Icon="@Icons.Material.Outlined.Info" Size="Size.Small" Class="d-block" />
                </MudTooltip>
            </span>
        </MudSlider>
    }

    @if (_loadingModel)
    {
        <MudStack Spacing="1">
            <MudProgressLinear Value="@_downloadPercent"
                               Color="Color.Primary"
                               Rounded />
            <MudStack Row Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.caption">@_loadingStatus</MudText>
                <MudText Typo="Typo.caption">@_downloadPercent%</MudText>
            </MudStack>
        </MudStack>
    }
    else if (_busy)
    {
        <MudStack Spacing="1">
            <MudProgressLinear Indeterminate Color="Color.Primary"/>
            <MudStack Row AlignItems="AlignItems.Center">
                @if (_runStatus is not null)
                {
                    <MudText Typo="Typo.caption">@_runStatus</MudText>
                }
                <MudSpacer />
                <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="CancelRun">@Strings.Cancel</MudButton>
            </MudStack>
        </MudStack>
    }

    @if (Chat.IsModelLoaded)
    {
        <MudStack Row AlignItems="AlignItems.Center">
            <MudChip T="string"
                     Size="Size.Small"
                     Variant="Variant.Outlined"
                     Color="@(Chat.IsGpuActive ? Color.Success : Color.Warning)">
                @(Chat.IsGpuActive ? "GPU" : "CPU")
            </MudChip>
            <MudSpacer />
            @if (_summary is not null && !_busy)
            {
                <MudButton Variant="Variant.Outlined"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Outlined.Download"
                           OnClick="DownloadPdfAsync">@Strings.DownloadPdf</MudButton>
            }
        </MudStack>
    }

    @if (_error is not null)
    {
        <MudAlert Severity="Severity.Error">@_error</MudAlert>
    }

    @if (_notice is not null)
    {
        <MudAlert Severity="Severity.Info">@_notice</MudAlert>
    }

    @if (_sections.Count > 0)
    {
        <MudPaper Class="pa-8" Elevation="0" Outlined>
            @if (_plan is not null)
            {
                <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-4" Style="font-weight: 700;">@_plan.Title</MudText>
            }

            @if (_summary is not null)
            {
                <MudText Typo="Typo.subtitle1" Class="report-heading">@Strings.ExecutiveSummary</MudText>
                <MudText Typo="Typo.body2" Class="mt-2 mb-6" Style="white-space: pre-wrap;">@_summary</MudText>
            }

            @foreach (Section section in _sections)
            {
                <MudText Typo="Typo.subtitle1" Class="report-heading">@section.Heading</MudText>
                <MudText Typo="Typo.body2" Class="mt-2" Style="white-space: pre-wrap;">@section.Text</MudText>

                <MudExpansionPanels Elevation="0" Outlined Dense Class="mt-4 mb-6 border border-solid mud-border-lines-default rounded">
                    <MudExpansionPanel Text="@Strings.Sources">
                        <MudStack Spacing="1" AlignItems="AlignItems.Start" Class="pb-3">
                            @foreach (Source source in section.Sources)
                            {
                                <MudLink Href="@source.Url" Target="_blank" rel="noopener noreferrer" Typo="Typo.body2">@Helpers.Truncate(source.Title, MaxSourceLengthChars)</MudLink>
                            }
                        </MudStack>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }

            @if (!_busy && Chat.TotalTokens > 0)
            {
                double tokensPerSecond = 0;

                if (Chat.TotalGenerationTime > TimeSpan.Zero)
                    tokensPerSecond = Chat.TotalTokens / Chat.TotalGenerationTime.TotalSeconds;

                <MudStack Row Spacing="3" Class="mt-4">
                    <MudText Typo="Typo.caption">@string.Format(Strings.TokensPerSecond, tokensPerSecond)</MudText>
                    <MudText Typo="Typo.caption">@string.Format(Strings.TokenCount, Chat.TotalTokens)</MudText>
                </MudStack>
            }
        </MudPaper>
    }

    @if (_skippedSections.Count > 0 || _failedSections.Count > 0)
    {
        <MudStack Spacing="1">
            @foreach (string heading in _skippedSections)
            {
                <MudText Typo="Typo.caption" Color="Color.Warning">@string.Format(Strings.SectionSkipped, heading)</MudText>
            }
            @foreach (string heading in _failedSections)
            {
                <MudText Typo="Typo.caption" Color="Color.Error">@string.Format(Strings.SectionFailed, heading)</MudText>
            }
        </MudStack>
    }

    @if (_results.Count > 0 && _scores.Length == _results.Count)
    {
        <MudPaper Class="pa-4" Elevation="0" Outlined>
            <MudText Typo="Typo.overline">@_keptCount / @_results.Count</MudText>
            <MudStack Spacing="1">
                @foreach (int i in Enumerable.Range(0, _results.Count).OrderByDescending(index => _scores[index]))
                {
                    SearchResult result = _results[i];
                    float score = _scores[i];

                    <MudStack Row Spacing="2" AlignItems="AlignItems.Center">
                        <MudLink Href="@result.Url" Target="_blank" rel="noopener noreferrer" Typo="Typo.body2">@Helpers.Truncate(result.Title, MaxSourceLengthChars)</MudLink>
                        <MudText Typo="Typo.caption">@result.Engine</MudText>
                        <MudSpacer />
                        <MudText Typo="Typo.caption" Color="@(Helpers.ToPercent(score) >= Helpers.ToPercent(_pageThreshold) ? Color.Success : Color.Error)">@score.ToString("P0")</MudText>
                    </MudStack>
                }
            </MudStack>
        </MudPaper>
    }
</MudStack>
